<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- CA1716: Identifiers should not match keywords (Shared, Error) -->
    <!-- CA1000: Do not declare static members on generic types (Result<T>.Success) -->
    <!-- CA1707: Identifiers should not contain underscores (used in test method naming conventions) -->
    <!-- CS1591: Missing XML comment for publicly visible type or member -->
    <NoWarn>$(NoWarn);1591;CA1716;CA1000;CA1707</NoWarn>
  </PropertyGroup>
</Project>
